# このファイルをコピーして backend/.env.local を作る（ホストで直接起動するとき用）:
#   cp .env.example .env.local
# docker で起動する場合は docker-compose.yml の environment: が使われるので不要。

# 実行環境（必須）。ローカルは local、本番は production
NODE_ENV=local

# Fastify サーバー
PORT=4000
HOST=0.0.0.0

# PostgreSQL（docker-compose の既定値に合わせている）
# ホストからは 5434 で繋ぐ（コンテナ内は db:5432）
DATABASE_URL=postgres://postgres:postgres@localhost:5434/management_app

# 本番(NODE_ENV=production)のときだけ使う CORS 許可オリジン。カンマ区切り。
# 例: CORS_ORIGIN=https://example.com,https://www.example.com
# CORS_ORIGIN=
